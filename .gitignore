# Example .gitignore file for your config dir.
# An * ensures that everything will be ignored.

# You can whitelist files/folders with !, these will not be ignored.
!*.yaml
!.gitignore
!*.md
!automations
!template_sensors

# Ignore folders.
.storage
.cloud
.google.token
blueprints/
custom_components/
solcast_solar/
www/

# Ensure these YAML files are ignored, otherwise your secret data/credentials will leak.
ip_bans.yaml
secrets.yaml
known_devices.yaml

# HA stuff
home-assistant_v2.db*
home-assistant.log*
backup/
backups/
*.tar
*.tar.gz
.HA*
.ha*
zigbee*

# Keys / certs
*.key
*.pem
*.crt

# Caches
deps/
tts/
__pycache__/
*.pyc
